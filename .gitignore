# Python virtual environment
backend/.venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables (keep API keys secret)
backend/.env
.env

# SQLite database
backend/database/*.db

# Generated images and uploads
backend/storage/generated/*
backend/storage/uploads/*

# Keep folders but ignore files inside them
!backend/storage/generated/.gitkeep
!backend/storage/uploads/.gitkeep

# VS Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp